# Copy this file to server/.env and enter real SMTP values.
PORT=5000

# SMTP example for Gmail. Use a Google App Password, not the normal password.
EMAIL_USER=Mischtisch.sachsen@gmail.com
EMAIL_PASS=your-google-app-password
EMAIL_FROM=Mischtisch Sachsen <Mischtisch.sachsen@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true

# Template 02 is sent to this organization/admin address.
REGISTRATION_REVIEW_EMAIL=info@mischtisch-sachsen.de
VERIFICATION_TEAM_NAME=Prüfteam Mischtisch Sachsen


REACT_APP_MAIL_API=https://lightcyan-caribou-270608.hostingersite.com/api/send-email
REACT_APP_REGISTRATION_MAIL_API=https://lightcyan-caribou-270608.hostingersite.com/api/send-registration-emails


# SMTP.js SecureToken generated with your Elastic Email SMTP credentials.
# Do not put the Elastic Email SMTP username/password in this React file.
REACT_APP_SMTP_SECURE_TOKEN=your-smtp-secure-token

# This address must be an approved/verified sender in Elastic Email.
REACT_APP_MAIL_FROM=Mischtisch.sachsen@gmail.com
REACT_APP_MAIL_FROM_NAME=Mischtisch Sachsen

